# Local development can omit DATABASE_URL and use SQLite.
# Production: copy the exact Supabase PostgreSQL connection string from Supabase -> Connect.
DATABASE_URL=
DATABASE_POOLING=true

JWT_SECRET=replace-with-a-long-random-secret
SESSION_HOURS=12
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

GROQ_API_KEY=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=
TWILIO_EMERGENCY_CONTACT=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=aarogyamitra-reports

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60
MAX_REQUEST_BYTES=1000000
